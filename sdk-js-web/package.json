{
  "name": "@mauriciobenjamin700/ort-vision-sdk-web",
  "version": "0.8.0",
  "description": "High-level TypeScript SDK for browser computer vision inference with ONNX Runtime Web.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "onnxruntime-web": ">=1.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "onnxruntime-web": "^1.17.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "onnx",
    "onnxruntime",
    "computer-vision",
    "inference",
    "sdk",
    "web",
    "browser",
    "webgpu",
    "wasm",
    "yolo",
    "image-classification",
    "object-detection"
  ],
  "license": "MIT",
  "author": "Mauricio Benjamin <mauriciobenjamin700@gmail.com>",
  "homepage": "https://github.com/mauriciobenjamin700/ort-vision-sdk/tree/main/sdk-js-web#readme",
  "bugs": {
    "url": "https://github.com/mauriciobenjamin700/ort-vision-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mauriciobenjamin700/ort-vision-sdk.git",
    "directory": "sdk-js-web"
  },
  "publishConfig": {
    "access": "public"
  }
}
